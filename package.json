{
	"name": "@sapphire-sh/ui",
	"version": "0.3.0",
	"description": "@sapphire-sh/ui",
	"type": "module",
	"sideEffects": [
		"*.css"
	],
	"exports": {
		".": {
			"types": "./lib/index.d.ts",
			"import": "./lib/index.js"
		},
		"./tokens": {
			"types": "./lib/tokens.d.ts",
			"import": "./lib/tokens.js"
		},
		"./theme.css": "./lib/theme.css"
	},
	"files": [
		"lib/**/*"
	],
	"scripts": {
		"bootstrap": "sapphire-bootstrap",
		"prebuild": "rm -fr ./lib",
		"build": "tsc -p tsconfig.build.json && cp src/theme.css lib/theme.css",
		"prepare": "npm run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prettier": "prettier --check .",
		"prettier:fix": "prettier --write .",
		"test": "vitest run",
		"playground:dev": "next dev playground",
		"playground:build": "npm run build && next build playground"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sapphire-sh/sapphire-ui.git"
	},
	"author": "sapphire",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/sapphire-sh/sapphire-ui/issues"
	},
	"homepage": "https://github.com/sapphire-sh/sapphire-ui#readme",
	"peerDependencies": {
		"next": ">=16.0.0",
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0",
		"tailwindcss": ">=4.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sapphire-sh/utils": "^3.34.0",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.13.0",
		"eslint-config-next": "^16.4.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-promise": "^7.3.0",
		"jsdom": "^30.1.3",
		"next": "^16.4.3",
		"prettier": "^3.9.10",
		"prettier-plugin-organize-imports": "^4.3.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"tailwindcss": "^4.3.3",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.72.0",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"fsevents@2.3.3": true,
		"unrs-resolver@1.12.2": true
	},
	"dependencies": {
		"lucide-react": "^1.61.0"
	}
}
